#!/usr/bin/env python3
"""Claude Usage - statistiche di utilizzo di Claude Code (GTK4 + libadwaita).

Legge le trascrizioni JSONL in ~/.claude/projects/**/*.jsonl, deduplica le voci
(message.id + requestId) e mostra totali, ripartizione per modello/progetto,
grafico giornaliero e un costo STIMATO.

Mostra anche i LIMITI dell'abbonamento Claude (sessione di 5 ore, settimanali,
per modello...) letti dallo stesso endpoint usato da `/usage` in Claude Code:
GET https://api.anthropic.com/api/oauth/usage con il token OAuth di
~/.claude/.credentials.json. Il token viene solo letto (mai rinnovato, mai
stampato, mai salvato) e inviato solo ad api.anthropic.com.

Uso:
    claude-usage                  avvia l'interfaccia grafica
    claude-usage --dump           stampa le statistiche su terminale (senza GUI)
    claude-usage --limits         stampa i limiti dell'abbonamento (senza GUI)
    claude-usage --limits --json  idem in JSON (usato dall'estensione GNOME)
    claude-usage --version        stampa la versione
"""

__version__ = "0.1.1"

