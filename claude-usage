APP_ID = "io.github.dnviti.ClaudeUsage"
PROJECTS_DIR = os.path.expanduser("~/.claude/projects")
FIELDS = ("inp", "out", "cw5", "cw1h", "cr")

# cache per file: path -> (mtime_ns, size, records)
_file_cache = {}


def price_for(model):
    best = None
    for key in PRICES:
        if model.startswith(key) and (best is None or len(key) > len(best)):
            best = key
    return PRICES[best] if best else None


def cost_of(model, r):
    p = price_for(model)
    if not p:
        return 0.0
    return sum(r[f] * p[f] for f in FIELDS) / 1_000_000


def decode_dirname(name):
    """Fallback: decodifica ambigua del nome cartella (i '-' di path e nomi si confondono)."""
    path = "/" + name.lstrip("-").replace("-", "/")
    home = os.path.expanduser("~")
    if path.startswith(home):
        path = "~" + path[len(home):]
    return path


def pretty_path(p):
    home = os.path.expanduser("~")
    if p == home:
        return "~"
    if p.startswith(home + "/"):
        return "~" + p[len(home):]
    return p


def _parse_file(path):
    """Restituisce {key: record} per un file; i chunk ripetuti si fondono prendendo il massimo."""
    out = {}
    cwd = None
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return out, None
    with fh:
        for line in fh:
            if '"usage"' not in line and '"cwd"' not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if cwd is None and isinstance(d.get("cwd"), str):
                cwd = d["cwd"]
            if d.get("type") != "assistant":
                continue
            m = d.get("message") or {}
            u = m.get("usage")
            model = m.get("model")
            if not isinstance(u, dict) or not model or model.startswith("<"):
                continue
            ts = d.get("timestamp")
            if not ts:
                continue
            try:
                dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
            except ValueError:
                continue
            cc = u.get("cache_creation") or {}
            cw5 = cc.get("ephemeral_5m_input_tokens")
            cw1h = cc.get("ephemeral_1h_input_tokens")
            total_cw = u.get("cache_creation_input_tokens") or 0
            if cw5 is None and cw1h is None:
                cw5, cw1h = total_cw, 0
            else:
                cw5, cw1h = cw5 or 0, cw1h or 0
            rec = dict(
                dt=dt, model=model,
                inp=u.get("input_tokens") or 0,
                out=u.get("output_tokens") or 0,
                cw5=cw5, cw1h=cw1h,
                cr=u.get("cache_read_input_tokens") or 0,
            )
            mid, rid = m.get("id"), d.get("requestId")
            key = (mid, rid) if (mid or rid) else ("uuid", d.get("uuid") or id(d))
            old = out.get(key)
            if old:
                for f in FIELDS:
                    rec[f] = max(rec[f], old[f])
                rec["dt"] = min(rec["dt"], old["dt"])
            out[key] = rec
    return out, cwd


def collect(since=None):
    """Scansiona tutto e restituisce (lista record deduplicati, info).

    Con `since` (timestamp) salta i file non modificati da allora: utile per
    calcolare solo "oggi" senza leggere tutto lo storico.
    """
    seen_paths = set()
    merged = {}
    proj_names = {}
    nfiles = 0
    for root, _dirs, files in os.walk(PROJECTS_DIR):
        rel = os.path.relpath(root, PROJECTS_DIR)
        proj_dir = rel.split(os.sep)[0]
        for fn in files:
            if not fn.endswith(".jsonl"):
                continue
            path = os.path.join(root, fn)
            try:
                st = os.stat(path)
            except OSError:
                continue
            seen_paths.add(path)
            if since is not None and st.st_mtime < since:
                continue
            c = _file_cache.get(path)
            if c and c[0] == st.st_mtime_ns and c[1] == st.st_size:
                recs, cwd = c[2], c[3]
            else:
                recs, cwd = _parse_file(path)
                _file_cache[path] = (st.st_mtime_ns, st.st_size, recs, cwd)
            nfiles += 1
            if cwd and proj_dir not in proj_names:
                proj_names[proj_dir] = pretty_path(cwd)
            for key, rec in recs.items():
                if key in merged:
                    old = merged[key]
                    for f in FIELDS:
                        old["rec"][f] = max(old["rec"][f], rec[f])
                else:
                    merged[key] = {"rec": dict(rec), "proj": proj_dir}
    for p in list(_file_cache):
        if p not in seen_paths:
            del _file_cache[p]
    records = []
    for v in merged.values():
        r = v["rec"]
        r["project"] = proj_names.get(v["proj"]) or decode_dirname(v["proj"])
        r["day"] = r["dt"].astimezone().date()
        r["cost"] = cost_of(r["model"], r)
        records.append(r)
    return records, {"files": nfiles}


def blank():
    return dict(n=0, inp=0, out=0, cw5=0, cw1h=0, cr=0, cost=0.0)


def add(acc, r):
    acc["n"] += 1
    for f in FIELDS:
        acc[f] += r[f]
    acc["cost"] += r["cost"]


def compute(records):
    today = datetime.now().astimezone().date()
    periods = {"today": 0, "7d": 6, "30d": 29, "all": None}
    totals = {k: blank() for k in periods}
    by_model = {k: defaultdict(blank) for k in periods}
    by_proj = {k: defaultdict(blank) for k in periods}
    daily = {today - timedelta(days=i): blank() for i in range(29, -1, -1)}
    unpriced = set()
    for r in records:
        if price_for(r["model"]) is None:
            unpriced.add(r["model"])
        age = (today - r["day"]).days
        for k, lim in periods.items():
            if lim is None or 0 <= age <= lim:
                add(totals[k], r)
                add(by_model[k][r["model"]], r)
                add(by_proj[k][r["project"]], r)
        if r["day"] in daily:
            add(daily[r["day"]], r)
    return dict(totals=totals, by_model=by_model, by_proj=by_proj, daily=daily,
                unpriced=sorted(unpriced), updated=datetime.now())


# ---------------------------------------------------------------- formattazione
def fmt_int(n):
    return f"{n:,}".replace(",", ".")


def fmt_tok(n):
    if n >= 1_000_000_000:
        return f"{n / 1e9:.2f} G".replace(".", ",")
    if n >= 1_000_000:
        return f"{n / 1e6:.2f} M".replace(".", ",")
    if n >= 10_000:
        return f"{n / 1e3:.1f} k".replace(".", ",")
    return fmt_int(n)


def fmt_cost(c):
    return "$" + f"{c:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")


