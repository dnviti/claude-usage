    print("== Totali ==")
    hdr = f"{'Periodo':<18}{'Msg':>8}{'Input':>12}{'Output':>12}{'Cache scr.':>14}{'Cache lett.':>14}{'Costo stim.':>14}"
    print(hdr)
    for k, lab in PERIOD_LABELS:
        t = stats["totals"][k]
        print(f"{lab:<18}{fmt_int(t['n']):>8}{fmt_tok(t['inp']):>12}{fmt_tok(t['out']):>12}"
              f"{fmt_tok(t['cw5'] + t['cw1h']):>14}{fmt_tok(t['cr']):>14}{fmt_cost(t['cost']):>14}")
    for title, key in (("Per modello (sempre)", "by_model"), ("Per progetto (sempre)", "by_proj")):
        print(f"\n== {title} ==")
        rows = sorted(stats[key]["all"].items(), key=lambda kv: -kv[1]["cost"])
        for name, t in rows:
            print(f"{name:<55.55}{fmt_int(t['n']):>8}{fmt_tok(t['out']):>11}{fmt_cost(t['cost']):>12}")
